{
  "name": "obsidian-vault-fetch",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "description": "Install and update Obsidian plugins from private GitHub repositories.",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs && node scripts/validate-package.mjs --bundle",
    "typecheck": "tsc --noEmit",
    "lint:compat": "eslint src --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint:compat && npm test && node scripts/validate-package.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.6.0",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.8"
  },
  "engines": {
    "node": ">=22"
  }
}
